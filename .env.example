# API Keys (Replace with your actual keys)
VITE_OPENAI_KEY=your_openai_api_key
VITE_GROQ_KEY=your_groq_api_key
VITE_ANTHROPIC_KEY=your_anthropic_api_key
VITE_DEEPSEEK_KEY=your_deepseek_api_key
VITE_HUGGINGFACE_KEY=your_huggingface_api_key
VITE_OPENROUTER_KEY=your_openrouter_api_key
VITE_ELEVENLABS_KEY=your_elevenlabs_api_key
VITE_BRAVE_API_KEY=your_brave_api_key
VITE_STORAGE_KEY=your_storage_encryption_key_here

# Supabase Configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_SERVICE_KEY=
VITE_ENCRYPTION_KEY=your_encryption_key_for_api_keys

# API Configuration
VITE_API_URL=http://localhost:3001
VITE_MCP_SERVER_URL=http://localhost:3001
VITE_API_TIMEOUT=30000
VITE_MAX_RETRIES=3

# Default Provider
VITE_DEFAULT_PROVIDER=openai
VITE_DEFAULT_MODEL=gpt-4o

# Feature Flags
VITE_ENABLE_VIDEO=true
VITE_ENABLE_FILE_UPLOAD=true
VITE_ENABLE_VOICE=true
VITE_ENABLE_STRUCTURED_OUTPUT=true
VITE_ENABLE_WEB_SEARCH=true

# Performance
VITE_MAX_FILE_SIZE=5242880  # 5MB in bytes
VITE_MAX_AUDIO_DURATION=300 # 5 minutes in seconds
VITE_MAX_VIDEO_DURATION=300 # 5 minutes in seconds

# Security
VITE_ALLOWED_FILE_TYPES=text/plain,image/jpeg,image/png
VITE_MAX_MESSAGE_LENGTH=4000

# UI Configuration
VITE_THEME_COLOR=#1d4ed8
VITE_APP_NAME=W3J Assistant
VITE_APP_VERSION=1.0.0

# Development
VITE_DEV_MODE=true
VITE_DEV_API_URL=http://localhost:5173
VITE_DEV_WS_URL=ws://localhost:5173

# Production
VITE_PROD_API_URL=https://your-production-url.com
VITE_PROD_WS_URL=wss://your-production-url.com

# Analytics
VITE_ENABLE_ANALYTICS=false
VITE_ANALYTICS_ID=your_analytics_id_here

# Error Reporting
VITE_ENABLE_ERROR_REPORTING=true
VITE_ERROR_REPORTING_URL=/api/errors

# Monitoring
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_PERFORMANCE_MONITORING_URL=/api/metrics

# Cache Configuration
VITE_CACHE_TTL=3600
VITE_MAX_CACHE_SIZE=100

# Rate Limiting
VITE_MAX_REQUESTS_PER_MINUTE=60
VITE_RATE_LIMIT_WINDOW=60000

# Backup
VITE_ENABLE_AUTO_BACKUP=true
VITE_BACKUP_INTERVAL=3600000 # 1 hour in milliseconds

# Voice Configuration
VITE_VOICE_LANGUAGE=en-US
VITE_VOICE_SAMPLE_RATE=16000
VITE_VOICE_CHANNELS=1

# Video Configuration
VITE_VIDEO_MAX_WIDTH=1280
VITE_VIDEO_MAX_HEIGHT=720
VITE_VIDEO_FRAME_RATE=30
VITE_VIDEO_BITRATE=2500000

# AI Configuration
VITE_AI_MAX_TOKENS=1000
VITE_AI_TEMPERATURE=0.7
VITE_AI_TOP_P=0.9
VITE_AI_FREQUENCY_PENALTY=0.0
VITE_AI_PRESENCE_PENALTY=0.0

# Accessibility
VITE_ENABLE_SCREEN_READER=true
VITE_ENABLE_HIGH_CONTRAST=false
VITE_ENABLE_REDUCED_MOTION=false

# Internationalization
VITE_DEFAULT_LANGUAGE=en
VITE_SUPPORTED_LANGUAGES=en,es,fr,de,ja,zh

# PWA Configuration
VITE_ENABLE_PWA=true
VITE_PWA_CACHE_VERSION=1
VITE_PWA_APP_NAME=W3J Assistant
VITE_PWA_SHORT_NAME=W3J
VITE_PWA_THEME_COLOR=#1d4ed8
VITE_PWA_BACKGROUND_COLOR=#1a1a1a

# Documentation
VITE_DOCS_URL=https://your-docs-url.com
VITE_SUPPORT_EMAIL=support@your-domain.com
VITE_GITHUB_REPO=https://github.com/yourusername/w3j-assistant
