{
  "name": "react-ai-chat",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server.js",
    "server:dev": "NODE_ENV=development node server.js",
    "server:prod": "NODE_ENV=production node server.js",
    "start": "npm run build && npm run server",
    "start:dev": "npm run build && npm run server:dev",
    "start:prod": "npm run build && npm run server:prod",
    "test-brave": "node test-brave-api.js",
    "lint": "eslint src --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "install:prod": "npm ci --only=production",
    "netlify:dev": "netlify dev",
    "netlify:build": "npm run build && netlify-lambda build netlify/functions",
    "netlify:deploy": "npm run build && netlify deploy --prod",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "type": "module",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/supabase-js": "^2.49.4",
    "axios": "^1.6.7",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dompurify": "^3.0.8",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^7.2.0",
    "i18next": "^25.0.0",
    "i18next-browser-languagedetector": "^8.0.5",
    "i18next-http-backend": "^3.0.2",
    "lucide-react": "^0.314.0",
    "marked": "^11.1.1",
    "netlify-cli": "^17.15.2",
    "netlify-lambda": "^2.0.16",
    "openai": "^4.28.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^15.4.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.22.3",
    "react-syntax-highlighter": "^15.5.0",
    "react-webcam": "^7.2.0",
    "recharts": "^2.15.3",
    "remark-gfm": "^4.0.0",
    "serverless-http": "^3.2.0",
    "socket.io-client": "^4.7.4",
    "uuid": "^9.0.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.11",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "msw": "^2.0.11",
    "postcss": "^8.4.32",
    "rollup-plugin-visualizer": "^5.14.0",
    "tailwindcss": "^3.3.0",
    "terser": "^5.39.0",
    "vite": "^5.0.8",
    "vitest": "^1.0.4"
  }
}
